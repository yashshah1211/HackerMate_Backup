# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# scratch and temporary diagnostic directories
/scratch
scratch/
/tmp
tmp/
/debug
debug/

# env files
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# Supabase CLI local runtime state
supabase/.temp/

# PostHog CLI wizard cache
.posthog/

# Local IDE configuration
.vscode/
.idea/

# Generated PDF reports & binary document exports
*.pdf
!public/sih1330_sample_pitch.pdf
